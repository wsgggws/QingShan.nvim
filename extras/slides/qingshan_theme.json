{
  "document": {
    "color": "#DCE8D5",
    "background_color": "#1D3229",
    "block_prefix": "\n\n\n\n\n",
    "block_suffix": "\n",
    "margin": 33
  },
  "block_quote": {
    "color": "#ADA594",
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "level_indent": 4
  },
  "heading": {
    "color": "#99CEBE",
    "block_suffix": "\n\n",
    "bold": true
  },
  "h1": {
    "color": "#DCE8D5",
    "prefix": "██ ",
    "suffix": " ",
    "bold": true
  },
  "h2": {
    "color": "#99CEBE",
    "prefix": "▓▓▓ "
  },
  "h3": {
    "color": "#A8C38B",
    "prefix": "▒▒▒▒ "
  },
  "h4": {
    "color": "#C5AD78",
    "prefix": "░░░░░ "
  },
  "h5": {
    "color": "#D7C5A0"
  },
  "h6": {
    "color": "#ADA594"
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "color": "#DCE8D5",
    "bold": true
  },
  "hr": {
    "color": "#56785D",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#99CEBE",
    "underline": true
  },
  "link_text": {
    "color": "#99CEBE",
    "bold": true
  },
  "image": {
    "color": "#D7C5A0",
    "underline": true
  },
  "image_text": {
    "color": "#ADA594",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "color": "#C6D8A3",
    "prefix": "",
    "suffix": "",
    "background_color": "#243B2E"
  },
  "code_block": {
    "color": "#DCE8D5",
    "background_color": "#1D3229",
    "margin": 0,
    "chroma": {
      "text": {
        "color": "#DCE8D5"
      },
      "error": {
        "color": "#D29580",
        "background_color": "#382F2A"
      },
      "comment": {
        "color": "#ADA594",
        "italic": true
      },
      "comment_preproc": {
        "color": "#D7C5A0"
      },
      "keyword": {
        "color": "#89C79B",
        "bold": true
      },
      "keyword_reserved": {
        "color": "#89C79B",
        "bold": true
      },
      "keyword_namespace": {
        "color": "#D7C5A0"
      },
      "keyword_type": {
        "color": "#A8C38B"
      },
      "operator": {
        "color": "#AEC0AB"
      },
      "punctuation": {
        "color": "#AEC0AB"
      },
      "name": {
        "color": "#DCE8D5"
      },
      "name_builtin": {
        "color": "#D7C5A0"
      },
      "name_tag": {
        "color": "#A8C38B"
      },
      "name_attribute": {
        "color": "#99CEBE"
      },
      "name_class": {
        "color": "#A8C38B"
      },
      "name_constant": {
        "color": "#C5AD78"
      },
      "name_decorator": {
        "color": "#D7C5A0"
      },
      "name_exception": {
        "color": "#D29580"
      },
      "name_function": {
        "color": "#99CEBE"
      },
      "name_other": {
        "color": "#DCE8D5"
      },
      "literal": {
        "color": "#C5AD78"
      },
      "literal_number": {
        "color": "#C5AD78"
      },
      "literal_date": {
        "color": "#C5AD78"
      },
      "literal_string": {
        "color": "#C6D8A3"
      },
      "literal_string_escape": {
        "color": "#D7C5A0"
      },
      "generic_deleted": {
        "color": "#D29580",
        "background_color": "#432F2B"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#A8C38B",
        "background_color": "#294630"
      },
      "generic_strong": {
        "color": "#DCE8D5",
        "bold": true
      },
      "generic_subheading": {
        "color": "#99CEBE",
        "bold": true
      },
      "background": {
        "color": "#DCE8D5",
        "background_color": "#1D3229"
      }
    }
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {
    "color": "#99CEBE",
    "bold": true
  },
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
